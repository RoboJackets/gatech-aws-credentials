{
    "extends": [
        "config:recommended"
    ],
    "labels": [],
    "reviewers": [],
    "ignoreDeps": [],
    "prConcurrentLimit": 1,
    "prHourlyLimit": 0,
    "rebaseWhen": "behind-base-branch",
    "vulnerabilityAlerts": {},
    "automerge": true,
    "platformAutomerge": true,
    "rangeStrategy": "pin",
    "timezone": "America/New_York",
    "schedule": [
        "before 4pm on Monday except before 9am on Monday"
    ],
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": [
            "before 4pm on Monday except before 9am on Monday"
        ]
    },
    "packageRules": [
        {
            "matchCategories": ["python"],
            "lockFileMaintenance": {
                "enabled": true,
                "schedule": ["before 4pm on Monday except before 9am on Monday"]
            },
            "matchDepNames": ["python"],
            "rangeStrategy": "replace"
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "rangeStrategy": "replace"
        }
    ]
}
